+package com.dotacionestoronto.dotacionestoronto.facturacion.service;
+
+import java.math.BigDecimal;
+import java.math.RoundingMode;
+
+/**
+ * Convierte un valor en pesos a letras, como se acostumbra en las facturas
+ * colombianas: 459000 -> "CUATROCIENTOS CINCUENTA Y NUEVE MIL PESOS M/CTE".
+ */
+public final class NumeroALetras {
+
+    private static final String[] UNIDADES = {
+            "CERO", "UNO", "DOS", "TRES", "CUATRO", "CINCO", "SEIS", "SIETE", "OCHO", "NUEVE",
+            "DIEZ", "ONCE", "DOCE", "TRECE", "CATORCE", "QUINCE", "DIECISEIS", "DIECISIETE",
+            "DIECIOCHO", "DIECINUEVE", "VEINTE", "VEINTIUNO", "VEINTIDOS", "VEINTITRES",
+            "VEINTICUATRO", "VEINTICINCO", "VEINTISEIS", "VEINTISIETE", "VEINTIOCHO", "VEINTINUEVE"
+    };
+
+    private static final String[] DECENAS = {
+            "", "", "", "TREINTA", "CUARENTA", "CINCUENTA", "SESENTA", "SETENTA", "OCHENTA", "NOVENTA"
+    };
+
+    private static final String[] CENTENAS = {
+            "", "CIENTO", "DOSCIENTOS", "TRESCIENTOS", "CUATROCIENTOS", "QUINIENTOS",
+            "SEISCIENTOS", "SETECIENTOS", "OCHOCIENTOS", "NOVECIENTOS"
+    };
+
+    private NumeroALetras() {
+    }
+
+    /** Ej: 459000 -> "CUATROCIENTOS CINCUENTA Y NUEVE MIL PESOS M/CTE". */
+    public static String pesos(BigDecimal valor) {
+        if (valor == null) {
+            return "CERO PESOS M/CTE";
+        }
+
+        BigDecimal redondeado = valor.setScale(0, RoundingMode.HALF_UP);
+        boolean negativo = redondeado.signum() < 0;
+        redondeado = redondeado.abs();
+
+        String entero = letras(redondeado.longValue());
+        String texto = entero + (redondeado.longValue() == 1 ? " PESO M/CTE" : " PESOS M/CTE");
+
+        return (negativo ? "MENOS " : "") + texto;
+    }
+
+    /** Número entero positivo o cero en letras. */
+    public static String letras(long numero) {
+
+        if (numero == 0) {
+            return "CERO";
+        }
+        if (numero == 100) {
+            return "CIEN";
+        }
+
+        StringBuilder sb = new StringBuilder();
+
+        long millones = numero / 1_000_000;
+        long miles = (numero % 1_000_000) / 1_000;
+        long resto = numero % 1_000;
+
+        if (millones > 0) {
+            if (millones == 1) {
+                sb.append("UN MILLON");
+            } else {
+                sb.append(centenas(millones)).append(" MILLONES");
+            }
+        }
+
+        if (miles > 0) {
+            if (sb.length() > 0) {
+                sb.append(' ');
+            }
+            sb.append(miles == 1 ? "MIL" : centenas(miles) + " MIL");
+        }
+
+        if (resto > 0) {
+            if (sb.length() > 0) {
+                sb.append(' ');
+            }
+            sb.append(centenas(resto));
+        }
+
+        return sb.toString().trim();
+    }
+
+    /** Convierte 1..999 a letras. */
+    private static String centenas(long n) {
+
+        if (n == 100) {
+            return "CIEN";
+        }
+
+        int centena = (int) (n / 100);
+        int resto = (int) (n % 100);
+
+        StringBuilder sb = new StringBuilder();
+
+        if (centena > 0) {
+            sb.append(CENTENAS[centena]);
+        }
+
+        if (resto > 0) {
+            if (centena > 0) {
+                sb.append(' ');
+            }
+            sb.append(decenas(resto));
+        }
+
+        return sb.toString();
+    }
+
+    /** Convierte 1..99 a letras. */
+    private static String decenas(int n) {
+
+        if (n < 30) {
+            return UNIDADES[n];
+        }
+
+        int decena = n / 10;
+        int unidad = n % 10;
+
+        return unidad == 0
+                ? DECENAS[decena]
+                : DECENAS[decena] + " Y " + UNIDADES[unidad];
+    }
+}
diff --git a/src/main/java/com/dotacionestoronto/dotacionestoronto/facturacion/service/PdfFacturaConvencionalService.java b/src/main/java/com/dotacionestoronto/dotacionestoronto/facturacion/service/PdfFacturaConvencionalService.java
