+package com.dotacionestoronto.dotacionestoronto.facturacion.service;
+
+import java.awt.Color;
+import java.awt.image.BufferedImage;
+import java.io.ByteArrayOutputStream;
+import java.io.InputStream;
+import java.math.BigDecimal;
+import java.math.RoundingMode;
+import java.text.DecimalFormat;
+import java.text.DecimalFormatSymbols;
+import java.time.format.DateTimeFormatter;
+import java.util.List;
+import java.util.Locale;
+
+import org.springframework.core.io.ClassPathResource;
+import org.springframework.stereotype.Service;
+
+import com.dotacionestoronto.dotacionestoronto.facturacion.config.FacturacionProperties;
+import com.dotacionestoronto.dotacionestoronto.facturacion.entity.DetalleFacturaElectronica;
+import com.dotacionestoronto.dotacionestoronto.facturacion.entity.FacturaElectronica;
+import com.lowagie.text.Document;
+import com.lowagie.text.Element;
+import com.lowagie.text.Font;
+import com.lowagie.text.FontFactory;
+import com.lowagie.text.Image;
+import com.lowagie.text.PageSize;
+import com.lowagie.text.Paragraph;
+import com.lowagie.text.Phrase;
+import com.lowagie.text.Rectangle;
+import com.lowagie.text.pdf.PdfPCell;
+import com.lowagie.text.pdf.PdfPTable;
+import com.lowagie.text.pdf.PdfWriter;
+
+/**
+ * Representación gráfica de la factura electrónica con el formato
+ * "convencional" colombiano: recuadros, sección de señores, valor en letras,
+ * firma del emisor y totales destacados.
+ *
+ * Convive con {@link PdfFacturaService} (formato moderno). Desde el panel se
+ * puede abrir cualquiera de los dos.
+ *
+ * Requisitos del artículo 35 de la Resolución 000165 de 2023 que se conservan:
+ * datos del emisor y del adquirente, numeración autorizada con su resolución,
+ * fecha y hora de expedición, descripción de los ítems, discriminación de
+ * impuestos, total, CUFE, código QR y leyenda de validación DIAN.
+ */
+@Service
+public class PdfFacturaConvencionalService {
+
+    private static final Color NEGRO = new Color(33, 37, 41);
+    private static final Color GRIS_LINEA = new Color(120, 128, 140);
+    private static final Color GRIS_TEXTO = new Color(85, 92, 105);
+    private static final Color GRIS_SUAVE = new Color(246, 247, 249);
+    private static final Color VERDE = new Color(25, 135, 84);
+    private static final Color ROJO = new Color(190, 40, 40);
+
+    private static final DateTimeFormatter F_FECHA = DateTimeFormatter.ofPattern("dd/MM/yyyy");
+    private static final DateTimeFormatter F_HORA = DateTimeFormatter.ofPattern("HH:mm:ss");
+
+    private final FacturacionProperties props;
+    private final CufeService cufeService;
+    private final QrService qrService;
+
+    public PdfFacturaConvencionalService(FacturacionProperties props,
+                                         CufeService cufeService,
+                                         QrService qrService) {
+        this.props = props;
+        this.cufeService = cufeService;
+        this.qrService = qrService;
+    }
+
+    public String nombreArchivo(FacturaElectronica f) {
+        return "Factura-" + f.getNumeroFactura() + "-convencional.pdf";
+    }
+
+    /** Alias por compatibilidad con el nombre usado en el resto del módulo. */
+    public byte[] generar(FacturaElectronica f) {
+        return generarConvencional(f);
+    }
+
+    public byte[] generarConvencional(FacturaElectronica f) {
+
+        ByteArrayOutputStream out = new ByteArrayOutputStream();
+        Document doc = new Document(PageSize.A4, 30, 30, 28, 30);
+
+        try {
+            PdfWriter.getInstance(doc, out);
+            doc.open();
+
+            doc.add(marco(cabecera(f)));
+            doc.add(espacio(6));
+            doc.add(marco(datosPartes(f)));
+            doc.add(espacio(6));
+            doc.add(tablaItems(f));
+            doc.add(espacio(6));
+            doc.add(bloqueValorEnLetrasYtotales(f));
+            doc.add(espacio(8));
+            doc.add(marco(pieFiscal(f)));
+            doc.add(espacio(6));
+            doc.add(notaLegal(f));
+
+            doc.close();
+            return out.toByteArray();
+
+        } catch (Exception e) {
+            throw new IllegalStateException(
+                    "No fue posible generar el PDF de la factura (formato convencional): " + e.getMessage(), e);
+        } finally {
+            if (doc.isOpen()) {
+                doc.close();
+            }
+        }
+    }
+
+    // ==========================================================
+    // CABECERA: emisor a la izquierda, recuadro del documento a la derecha
+    // ==========================================================
+    private PdfPTable cabecera(FacturaElectronica f) throws Exception {
+
+        PdfPTable tabla = new PdfPTable(new float[]{ 54f, 46f });
+        tabla.setWidthPercentage(100);
+
+        // ---------- Emisor ----------
+        PdfPCell emisor = new PdfPCell();
+        emisor.setBorder(Rectangle.NO_BORDER);
+        emisor.setPadding(6);
+
+        Image logo = cargarLogo();
+        if (logo != null) {
+            logo.scaleToFit(120, 52);
+            logo.setAlignment(Image.LEFT);
+            emisor.addElement(logo);
+        }
+
+        Paragraph razon = new Paragraph(texto(f.getRazonSocialEmisor()),
+                FontFactory.getFont(FontFactory.HELVETICA_BOLD, 12, NEGRO));
+        razon.setSpacingBefore(4);
+        emisor.addElement(razon);
+
+        emisor.addElement(parrafo(
+                "NIT. " + nitConDv(f.getNitEmisor(), f.getDvEmisor())
+                        + "   ·   Régimen " + texto(f.getRegimenEmisor()),
+                7.5f, false, GRIS_TEXTO));
+        emisor.addElement(parrafo(texto(f.getDireccionEmisor()) + "  ·  " + texto(f.getCiudadEmisor())
+                + "  ·  " + texto(f.getDepartamentoEmisor()), 7.5f, false, GRIS_TEXTO));
+        emisor.addElement(parrafo("Tel. " + texto(f.getTelefonoEmisor())
+                + "   ·   " + texto(f.getCorreoEmisor()), 7.5f, false, GRIS_TEXTO));
+        emisor.addElement(parrafo("Actividad económica " + texto(f.getActividadEconomicaEmisor())
+                + "   ·   Responsabilidades " + texto(f.getResponsabilidadesEmisor()), 7.5f, false, GRIS_TEXTO));
+
+        tabla.addCell(emisor);
+
+        // ---------- Recuadro del documento ----------
+        PdfPTable cajaDoc = new PdfPTable(1);
+        cajaDoc.setWidthPercentage(100);
+
+        PdfPCell titulo = new PdfPCell(new Phrase("FACTURA ELECTRÓNICA DE VENTA",
+                FontFactory.getFont(FontFactory.HELVETICA_BOLD, 10, NEGRO)));
+        titulo.setBorder(Rectangle.BOX);
+        titulo.setBorderColor(GRIS_LINEA);
+        titulo.setHorizontalAlignment(Element.ALIGN_CENTER);
+        titulo.setPadding(6);
+        titulo.setBackgroundColor(GRIS_SUAVE);
+        cajaDoc.addCell(titulo);
+
+        PdfPCell numero = new PdfPCell(new Phrase("No. " + texto(f.getNumeroFactura()),
+                FontFactory.getFont(FontFactory.HELVETICA_BOLD, 13, NEGRO)));
+        numero.setBorder(Rectangle.BOX);
+        numero.setBorderColor(GRIS_LINEA);
+        numero.setHorizontalAlignment(Element.ALIGN_CENTER);
+        numero.setPadding(5);
+        cajaDoc.addCell(numero);
+
+        PdfPCell fecha = new PdfPCell(new Phrase(
+                "Fecha: " + (f.getFechaEmision() != null ? f.getFechaEmision().format(F_FECHA) : "-")
+                        + "     Hora: " + (f.getFechaEmision() != null ? f.getFechaEmision().format(F_HORA) : "-"),
+                FontFactory.getFont(FontFactory.HELVETICA, 8, NEGRO)));
+        fecha.setBorder(Rectangle.BOX);
+        fecha.setBorderColor(GRIS_LINEA);
+        fecha.setHorizontalAlignment(Element.ALIGN_CENTER);
+        fecha.setPadding(4);
+        cajaDoc.addCell(fecha);
+
+        PdfPCell estado = new PdfPCell(new Phrase(estadoTexto(f),
+                FontFactory.getFont(FontFactory.HELVETICA_BOLD, 7.5f,
+                        "ACEPTADA".equals(f.getEstado()) ? VERDE
+                                : ("RECHAZADA".equals(f.getEstado()) || "ERROR".equals(f.getEstado()) ? ROJO : GRIS_TEXTO))));
+        estado.setBorder(Rectangle.BOX);
+        estado.setBorderColor(GRIS_LINEA);
+        estado.setHorizontalAlignment(Element.ALIGN_CENTER);
+        estado.setPadding(4);
+        cajaDoc.addCell(estado);
+
+        PdfPCell contenedor = new PdfPCell(cajaDoc);
+        contenedor.setBorder(Rectangle.NO_BORDER);
+        contenedor.setPadding(6);
+        tabla.addCell(contenedor);
+
+        return tabla;
+    }
+
+    // ==========================================================
+    // SEÑORES (adquirente) Y DATOS DEL DOCUMENTO
+    // ==========================================================
+    private PdfPTable datosPartes(FacturaElectronica f) {
+
+        PdfPTable tabla = new PdfPTable(new float[]{ 55f, 45f });
+        tabla.setWidthPercentage(100);
+
+        // ---------- Adquirente ----------
+        PdfPTable adq = new PdfPTable(new float[]{ 24f, 76f });
+        adq.setWidthPercentage(100);
+        adq.addCell(campoEtiqueta("SEÑORES"));
+        adq.addCell(campoCelda(texto(f.getRazonSocialAdquirente()), true));
