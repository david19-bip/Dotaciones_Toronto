+    // ==========================================================
+    // HELPERS DE FORMATO
+    // ==========================================================
+    private String moneda(BigDecimal valor) {
+        BigDecimal v = valor != null ? valor : BigDecimal.ZERO;
+        DecimalFormatSymbols simbolos = new DecimalFormatSymbols(new Locale("es", "CO"));
+        simbolos.setDecimalSeparator(',');
+        simbolos.setGroupingSeparator('.');
+        DecimalFormat formato = new DecimalFormat("#,##0.00", simbolos);
+        return "$ " + formato.format(v.setScale(2, RoundingMode.HALF_UP));
+    }
+
+    private String numero(BigDecimal valor) {
+        if (valor == null) {
+            return "0";
+        }
+        BigDecimal v = valor.stripTrailingZeros();
+        return v.scale() <= 0
+                ? String.valueOf(v.longValue())
+                : v.toPlainString();
+    }
+
+    private String fecha(java.time.LocalDate fecha) {
+        return fecha != null ? fecha.format(F_FECHA) : "-";
+    }
+
+    private String texto(String valor) {
+        return valor != null && !valor.isBlank() ? valor : "-";
+    }
+
+    /** Arma "NIT-DV" solo cuando hay dígito de verificación. */
+    private String nitConDv(String nit, String dv) {
+        if (nit == null || nit.isBlank()) {
+            return "-";
+        }
+        return dv != null && !dv.isBlank() ? nit + "-" + dv : nit;
+    }
+
+    private String estadoTexto(FacturaElectronica f) {
+        String estado = f.getEstado() != null ? f.getEstado() : "BORRADOR";
+        String sufijo = Boolean.TRUE.equals(f.getSimulado()) ? " (simulación)" : "";
+        return "Estado DIAN: " + estado + sufijo;
+    }
+
+    private String tipoDocCorto(String codigo) {
+        if (codigo == null) {
+            return "CC";
+        }
+        return switch (codigo) {
+            case "11" -> "RC";
+            case "12" -> "TI";
+            case "13" -> "CC";
+            case "21" -> "TE";
+            case "31" -> "NIT";
+            case "41" -> "PP";
+            case "42" -> "EE";
+            default -> "CC";
+        };
+    }
+
+    private String formaPagoTexto(String codigo) {
+        if (codigo == null) {
+            return "-";
+        }
+        return switch (codigo) {
+            case "1" -> "1 - Contado";
+            case "2" -> "2 - Crédito";
+            default -> codigo;
+        };
+    }
+
+    private String medioPagoTexto(String codigo) {
+        if (codigo == null) {
+            return "-";
+        }
+        return switch (codigo) {
+            case "10" -> "10 - Efectivo";
+            case "42" -> "42 - Consignación bancaria";
+            case "47" -> "47 - Transferencia";
+            case "48" -> "48 - Tarjeta crédito";
+            case "49" -> "49 - Tarjeta débito";
+            default -> codigo;
+        };
+    }
+}
