+    // ==========================================================
+    // TABLA DE ÍTEMS
+    // ==========================================================
+    private PdfPTable tablaItems(FacturaElectronica f) {
+
+        PdfPTable tabla = new PdfPTable(new float[]{ 10f, 38f, 8f, 13f, 9f, 10f, 12f });
+        tabla.setWidthPercentage(100);
+        tabla.setHeaderRows(1);
+
+        String[] encabezados = { "CÓDIGO", "DESCRIPCIÓN", "CANT.", "VR. UNITARIO", "DCTO.", "IVA", "VR. TOTAL" };
+        for (String h : encabezados) {
+            PdfPCell c = new PdfPCell(new Phrase(h, FontFactory.getFont(FontFactory.HELVETICA_BOLD, 7.5f, NEGRO)));
+            c.setBackgroundColor(GRIS_SUAVE);
+            c.setBorderColor(GRIS_LINEA);
+            c.setPadding(4);
+            c.setHorizontalAlignment(Element.ALIGN_CENTER);
+            c.setVerticalAlignment(Element.ALIGN_MIDDLE);
+            tabla.addCell(c);
+        }
+
+        List<DetalleFacturaElectronica> detalles = f.getDetalles();
+        int i = 0;
+
+        for (DetalleFacturaElectronica d : detalles) {
+
+            BigDecimal cantidad = d.getCantidad() != null ? d.getCantidad() : BigDecimal.ZERO;
+            BigDecimal precio = d.getPrecioUnitario() != null ? d.getPrecioUnitario() : BigDecimal.ZERO;
+            BigDecimal descuento = d.getDescuento() != null ? d.getDescuento() : BigDecimal.ZERO;
+            BigDecimal iva = d.getIvaValor() != null ? d.getIvaValor() : BigDecimal.ZERO;
+
+            BigDecimal totalLinea = d.getTotalLinea() != null && d.getTotalLinea().compareTo(BigDecimal.ZERO) != 0
+                    ? d.getTotalLinea()
+                    : precio.multiply(cantidad).subtract(descuento).add(iva);
+
+            tabla.addCell(celdaTexto(d.getCodigoProducto() != null ? d.getCodigoProducto() : String.valueOf(++i),
+                    Element.ALIGN_CENTER));
+            tabla.addCell(celdaTexto(texto(d.getDescripcion()), Element.ALIGN_LEFT));
+            tabla.addCell(celdaTexto(numero(cantidad), Element.ALIGN_CENTER));
+            tabla.addCell(celdaTexto(moneda(precio), Element.ALIGN_RIGHT));
+            tabla.addCell(celdaTexto(moneda(descuento), Element.ALIGN_RIGHT));
+            tabla.addCell(celdaTexto(moneda(iva), Element.ALIGN_RIGHT));
+            tabla.addCell(celdaTexto(moneda(totalLinea), Element.ALIGN_RIGHT));
+        }
+
+        if (detalles.isEmpty()) {
+            PdfPCell vacio = new PdfPCell(new Phrase("Sin ítems registrados",
+                    FontFactory.getFont(FontFactory.HELVETICA, 8, GRIS_TEXTO)));
+            vacio.setColspan(7);
+            vacio.setBorderColor(GRIS_LINEA);
+            vacio.setPadding(6);
+            vacio.setHorizontalAlignment(Element.ALIGN_CENTER);
+            tabla.addCell(vacio);
+        }
+
+        return tabla;
+    }
