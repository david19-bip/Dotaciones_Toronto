+        tot.addCell(totalEtiqueta("IVA"));
+        tot.addCell(totalValor(moneda(f.getTotalIva())));
+
+        if (f.getTotalImpuestos() != null
+                && f.getTotalIva() != null
+                && f.getTotalImpuestos().subtract(f.getTotalIva()).compareTo(BigDecimal.ZERO) > 0) {
+            tot.addCell(totalEtiqueta("Otros impuestos"));
+            tot.addCell(totalValor(moneda(f.getTotalImpuestos().subtract(f.getTotalIva()))));
+        }
+
+        PdfPCell etiquetaTotal = new PdfPCell(new Phrase("TOTAL A PAGAR",
+                FontFactory.getFont(FontFactory.HELVETICA_BOLD, 9.5f, NEGRO)));
