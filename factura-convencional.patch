+
+        // ---------- Totales ----------
+        PdfPTable tot = new PdfPTable(new float[]{ 58f, 42f });
+        tot.setWidthPercentage(100);
+
+        tot.addCell(totalEtiqueta("Subtotal"));
+        tot.addCell(totalValor(moneda(f.getValorBruto())));
+
+        if (f.getDescuentoTotal() != null && f.getDescuentoTotal().compareTo(BigDecimal.ZERO) > 0) {
+            tot.addCell(totalEtiqueta("Descuentos"));
