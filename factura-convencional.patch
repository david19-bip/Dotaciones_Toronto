+    // ==========================================================
+    // PIE FISCAL: QR, CUFE, resolución, software y firma
+    // ==========================================================
+    private PdfPTable pieFiscal(FacturaElectronica f) {
+
+        PdfPTable tabla = new PdfPTable(new float[]{ 17f, 60f, 23f });
+        tabla.setWidthPercentage(100);
+
+        // ---------- QR ----------
+        PdfPCell qrCell = new PdfPCell();
+        qrCell.setBorderColor(GRIS_LINEA);
+        qrCell.setPadding(4);
+        qrCell.setHorizontalAlignment(Element.ALIGN_CENTER);
+        qrCell.setVerticalAlignment(Element.ALIGN_MIDDLE);
+        try {
+            String contenidoQr = f.getQrUrl() != null ? f.getQrUrl() : cufeService.construirUrlQr(f);
+            BufferedImage qr = qrService.generarImagen(contenidoQr, 240);
+            Image qrImg = Image.getInstance(qr, null);
+            qrImg.scaleToFit(86, 86);
+            qrCell.addElement(qrImg);
+            qrCell.addElement(new Paragraph("Verificar en DIAN",
+                    FontFactory.getFont(FontFactory.HELVETICA, 6, GRIS_TEXTO)));
+        } catch (Exception e) {
+            qrCell.addElement(new Paragraph("QR no disponible",
+                    FontFactory.getFont(FontFactory.HELVETICA, 6, ROJO)));
+        }
+        tabla.addCell(qrCell);
+
+        // ---------- Datos fiscales ----------
+        PdfPCell datos = new PdfPCell();
+        datos.setBorderColor(GRIS_LINEA);
+        datos.setPadding(5);
+
+        datos.addElement(parrafo("CUFE:", 7, true, NEGRO));
+        datos.addElement(new Paragraph(texto(f.getCufe()),
+                FontFactory.getFont(FontFactory.COURIER, 6.5f, GRIS_TEXTO)));
+
+        datos.addElement(parrafo("Resolución de autorización de numeración DIAN No. "
+                + texto(f.getResolucionNumero())
+                + " del " + fecha(f.getResolucionVigenciaDesde())
+                + " al " + fecha(f.getResolucionVigenciaHasta())
+                + ". Prefijo " + texto(f.getPrefijo())
+                + " del " + texto(String.valueOf(f.getResolucionDesde()))
+                + " al " + texto(String.valueOf(f.getResolucionHasta())) + ".", 6.5f, false, GRIS_TEXTO));
+
+        datos.addElement(parrafo("Software: " + texto(props.getDian().getSoftwareNombre())
+                + "  ·  ID: " + texto(f.getSoftwareId())
+                + "  ·  Fabricante: " + texto(props.getEmisor().getFabricanteSoftware())
+                + " (NIT " + texto(props.getEmisor().getNit()) + ").", 6.5f, false, GRIS_TEXTO));
+
+        String leyenda = "ACEPTADA".equals(f.getEstado())
+                ? ("Documento validado por la DIAN"
+                        + (Boolean.TRUE.equals(f.getSimulado()) ? " (modo simulación - sin validez fiscal)" : "."))
+                : "Documento generado. Pendiente de validación por la DIAN.";
+
+        datos.addElement(parrafo(leyenda, 6.5f, true,
+                "ACEPTADA".equals(f.getEstado()) && !Boolean.TRUE.equals(f.getSimulado()) ? VERDE : GRIS_TEXTO));
+
+        if (f.getFechaRespuesta() != null) {
+            datos.addElement(parrafo("Fecha de validación DIAN: "
+                    + f.getFechaRespuesta().format(DateTimeFormatter.ofPattern("dd/MM/yyyy HH:mm:ss")),
+                    6.5f, false, GRIS_TEXTO));
+        }
+        tabla.addCell(datos);
+
+        // ---------- Firma ----------
+        PdfPCell firma = new PdfPCell();
+        firma.setBorderColor(GRIS_LINEA);
+        firma.setPadding(5);
+        firma.setVerticalAlignment(Element.ALIGN_BOTTOM);
+
+        firma.addElement(espacio(24));
+        firma.addElement(parrafo("__________________________________", 7, false, GRIS_TEXTO));
+        firma.addElement(parrafo(texto(f.getRazonSocialEmisor()), 7, true, NEGRO));
+        firma.addElement(parrafo("NIT. " + nitConDv(f.getNitEmisor(), f.getDvEmisor()), 6.5f, false, GRIS_TEXTO));
+        firma.addElement(parrafo("Firma del emisor", 6.5f, false, GRIS_TEXTO));
+
+        tabla.addCell(firma);
+
+        return tabla;
+    }
