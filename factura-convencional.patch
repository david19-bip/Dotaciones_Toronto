+    private Paragraph parrafo(String texto, float tamano, boolean negrita, Color color) {
+        return new Paragraph(texto,
+                FontFactory.getFont(negrita ? FontFactory.HELVETICA_BOLD : FontFactory.HELVETICA, tamano, color));
+    }
