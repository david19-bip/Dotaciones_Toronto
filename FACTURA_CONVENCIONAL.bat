@echo off
setlocal EnableDelayedExpansion
chcp 65001 >nul
title Factura en formato convencional - Dotaciones Toronto

REM =====================================================================
REM   FACTURA EN FORMATO CONVENCIONAL (recuadros, valor en letras, firma)
REM
REM   Que hace:
REM     - Agrega el generador del PDF con formato de factura colombiana
REM       clasica (el que se usa en papel: recuadros, "Senores", valor en
REM       letras, firma del emisor).
REM     - Deja ese formato como el que se ve por defecto.
REM     - Agrega en el detalle de cada factura los botones:
REM         Ver factura (formato convencional) / Ver PDF (formato moderno)
REM
REM   Como se usa:
REM     1. Guarda este archivo en la carpeta del proyecto
REM     2. Doble clic
REM     3. Espera a que diga LISTO
REM
REM   No borra nada: tus cambios se guardan antes en la rama respaldo-local.
REM   El arreglo va dentro de este mismo archivo.
REM =====================================================================

set "URL=https://github.com/david19-bip/Dotaciones_Toronto.git"
set "PARCHE=factura-convencional.patch"
set "B64=%TEMP%\factura_conv_b64.txt"

cd /d "%~dp0"

echo.
echo ==========================================================
echo    FACTURA EN FORMATO CONVENCIONAL
echo ==========================================================
echo.

if exist "pom.xml" goto proyecto_ok
echo No encontre el proyecto en esta carpeta:
echo    %CD%
echo.
set /p "CARPETA=Escribe la ruta completa de tu proyecto, por ejemplo C:\xampp\htdocs\repo : "
cd /d "!CARPETA!" 2>nul
if exist "pom.xml" goto proyecto_ok
echo.
echo [ERROR] En esa ruta tampoco encuentro el pom.xml.
goto fin_error

:proyecto_ok
echo Carpeta del proyecto: %CD%
echo.

echo [1/7] Revisando que todo este en orden ...
git --version >nul 2>&1
if not errorlevel 1 goto git_ok
echo.
echo [ERROR] Git no esta instalado. Descargalo en https://git-scm.com/download/win
goto fin_error

:git_ok
if exist ".git" goto repo_ok
echo.
echo [ERROR] Esta carpeta no es el repositorio del proyecto.
echo         Tiene que contener la carpeta oculta .git
goto fin_error

:repo_ok
where powershell >nul 2>&1
if not errorlevel 1 goto ps_ok
echo.
echo [ERROR] No encuentro PowerShell, que viene con Windows.
goto fin_error

:ps_ok
echo       Todo en orden.
echo.

echo [2/7] Preparando el arreglo ...
if not exist "%B64%" goto b64_limpio
del "%B64%" >nul 2>&1
