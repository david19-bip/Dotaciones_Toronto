echo.

git config user.name >nul 2>&1
if not errorlevel 1 goto nombre_ok
set /p "NOMBRE=Escribe tu nombre para los commits: "
git config user.name "!NOMBRE!"
:nombre_ok
git config user.email >nul 2>&1
if not errorlevel 1 goto correo_ok
set /p "CORREO=Escribe tu correo de GitHub: "
git config user.email "!CORREO!"
:correo_ok

echo [3/7] Revisando la conexion con GitHub ...
git remote get-url origin >nul 2>&1
if errorlevel 1 goto remoto_nuevo
for /f "delims=" %%r in ('git remote get-url origin') do set "ACTUAL=%%r"
if /i "!ACTUAL!"=="%URL%" goto remoto_ok
echo       Se corrige el remoto a %URL%
git remote set-url origin %URL%
goto remoto_ok
:remoto_nuevo
echo       No existia origin, se configura ahora.
git remote add origin %URL%
:remoto_ok
echo.

echo [4/7] Descargando la ultima version desde GitHub ...
git fetch origin
if not errorlevel 1 goto fetch_ok
echo.
echo [ERROR] No se pudo conectar con GitHub. Revisa tu internet.
goto fin_error
:fetch_ok
for /f "delims=" %%v in ('git rev-parse --short origin/master') do set "REMOTO=%%v"
echo       Ultimo commit en GitHub: !REMOTO!
echo.

echo [5/7] Guardando tus cambios locales, no se borra nada ...
set "SUCIO="
for /f "delims=" %%s in ('git status --porcelain --untracked-files=no') do set "SUCIO=1"
if not defined SUCIO goto sin_cambios
git rev-parse --verify respaldo-local >nul 2>&1
if errorlevel 1 goto rama_nueva
git checkout -q respaldo-local
goto rama_lista
:rama_nueva
git checkout -q -b respaldo-local
:rama_lista
git add -A
git reset -q -- "%PARCHE%" "%~nx0" >nul 2>&1
git commit -q -m "respaldo del estado local antes del formato convencional" >nul 2>&1
echo       Tus cambios quedaron en la rama respaldo-local.
goto master_listo
:sin_cambios
echo       No habia cambios sin guardar.

:master_listo
git checkout -q master 2>nul
if not errorlevel 1 goto en_master
git checkout -q -B master origin/master
:en_master
git merge -q --ff-only origin/master >nul 2>&1
for /f "delims=" %%c in ('git rev-parse --short HEAD') do set "LOCAL=%%c"
echo       Version local ahora: !LOCAL!
echo.

echo [6/7] Aplicando el formato convencional ...
if not exist "src\main\java\com\dotacionestoronto\dotacionestoronto\facturacion\service\PdfFacturaConvencionalService.java" goto aplicar
echo       Ya estaba aplicado. Se continua.
goto arreglo_listo

:aplicar
git apply --check "%PARCHE%" >nul 2>&1
if not errorlevel 1 goto aplicar_ok
echo.
echo [ERROR] El arreglo no encaja en esta version del proyecto.
echo         Ultimo commit local:
git log --oneline -1
echo         Copia este mensaje y mandalo en el chat.
goto fin_error

:aplicar_ok
git apply "%PARCHE%"
if not errorlevel 1 goto arreglo_listo
echo.
echo [ERROR] No se pudo aplicar el arreglo.
goto fin_error

:arreglo_listo
git status --short
echo.

echo [7/7] Compilando y ejecutando las pruebas, tarda 1 o 2 minutos ...
if exist "mvnw.cmd" goto con_wrapper
call mvn -q -B test
goto revisar
:con_wrapper
call mvnw.cmd -q -B test

:revisar
if not errorlevel 1 goto pruebas_ok
echo.
echo [AVISO] Las pruebas fallaron o Maven no esta disponible.
echo         El arreglo ya quedo aplicado en tu carpeta, pero NO se subio.
choice /M "Quieres hacer el commit y subir de todos modos"
if errorlevel 2 goto fin_sin_subir
goto commit
:pruebas_ok
echo       Pruebas OK, 16 de 16.
echo.

:commit
echo Confirmando y subiendo a GitHub ...
git add -A
git reset -q -- "%PARCHE%" "%~nx0" >nul 2>&1
git commit -m "feat(facturacion): representacion grafica en formato de factura convencional" >nul 2>&1
if errorlevel 1 echo       No habia cambios nuevos que confirmar.
git log --oneline -1
echo.
git push origin master
if not errorlevel 1 goto listo
echo.
echo [ERROR] No se pudo subir a GitHub.
echo   Usa un token personal de https://github.com/settings/tokens con permiso repo
echo   El arreglo YA esta aplicado en tu carpeta.
goto fin_error

:listo
echo.
echo ==========================================================
echo    LISTO.
echo.
echo    Para verlo:
echo        1. mvnw.cmd spring-boot:run
echo        2. Entra a http://localhost:8080/admin/facturacion
echo        3. Abre una factura y pulsa
echo           "Ver factura (formato convencional)"
echo.
echo    Las facturas nuevas ya se generan en ese formato por
echo    defecto (facturacion.formato-pdf=CONVENCIONAL).
echo ==========================================================
echo.
pause
exit /b 0

:fin_sin_subir
echo.
echo No se subio nada. El arreglo queda aplicado en tu carpeta.
pause
exit /b 1

:fin_error
echo.
pause
exit /b 1
